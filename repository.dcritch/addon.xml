<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.dcritch"
       name="dcritch's Kodi Add-ons"
       version="1.0.0"
       provider-name="dcritch">
    <extension point="xbmc.addon.repository" name="dcritch's Kodi Add-ons">
        <dir>
            <info compressed="false">https://stderr.ca/kodi/addons.xml</info>
            <checksum>https://stderr.ca/kodi/addons.xml.md5</checksum>
            <datadir zip="true">https://stderr.ca/kodi/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">dcritch's personal Kodi add-on repository</summary>
        <description lang="en_GB">Add-ons maintained by dcritch, including NTS Radio. Add this repository to Kodi to install them and receive updates automatically.</description>
        <platform>all</platform>
        <license>MIT</license>
        <source>https://github.com/dcritch/kodi-addons</source>
        <news>1.0.0 - Initial release.</news>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
